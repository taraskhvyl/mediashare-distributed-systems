POSTGRES_PASSWORD=dev-postgres-pass
API_DB_PASSWORD=dev-api-pass
PROCESSOR_DB_PASSWORD=dev-processor-pass
REDIS_PASSWORD=dev-redis-pass
# Redis ACL users for live events (compose/data.yml): publish-only / subscribe-only.
REDIS_NOTIFIER_PASSWORD=dev-redis-notifier-pass
REDIS_SSE_PASSWORD=dev-redis-sse-pass
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin
S3_ADMIN_ACCESS_KEY=root-admin
S3_ADMIN_SECRET_KEY=dev-admin-secret
S3_API_ACCESS_KEY=api-svc
S3_API_SECRET_KEY=dev-api-svc-secret
S3_PROCESSOR_ACCESS_KEY=processor-svc
S3_PROCESSOR_SECRET_KEY=dev-processor-svc-secret

# api replicas behind the gateway (default 1). 3 for the scaling experiments.
# API_REPLICAS=3

# api per-user write bucket (default 5 burst, 0.5/s). Load tests only: raise to measure
# capacity past policy, then remove. Defaults live in apps/api/src/config.ts.
# RATE_LIMIT_CAPACITY=1000000
# RATE_LIMIT_REFILL_PER_SECOND=1000000

# Tagger (Phase 7a). Dev defaults for its own Postgres role and S3 identity.
TAGGER_DB_PASSWORD=dev-tagger-pass
S3_TAGGER_ACCESS_KEY=tagger-svc
S3_TAGGER_SECRET_KEY=dev-tagger-svc-secret

# AI providers (Phase 7a). Real secrets: fill in .env only, never in .env.example.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Langfuse Cloud: project settings -> API keys. Host is the region you signed up in:
# https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Keycloak client secret of the MCP server (ADR 0009). Dev value; the realm import and the MCP server both read it.
MCP_CLIENT_SECRET=dev-mcp-client-secret

# Billing (ADR 0010). Dev values; the fake payments provider and billing share the first three.
BILLING_DB_PASSWORD=dev-billing-pass
PAYMENTS_WEBHOOK_SECRET=dev-payments-webhook-secret
PAYMENTS_API_KEY=dev-payments-api-key
PAYMENTS_CONTROL_KEY=dev-payments-control-key
MCP_BILLING_CLIENT_SECRET=dev-mcp-billing-client-secret
