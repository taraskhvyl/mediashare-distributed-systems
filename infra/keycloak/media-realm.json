{
  "realm": "media",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "user" },
      { "name": "admin" }
    ],
    "client": {}
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "media-api",
      "name": "Media API",
      "description": "The api as a resource server (aud of its tokens). Bearer-only: nobody logs in through it; it exists so token exchange can name it as the target audience.",
      "bearerOnly": true
    },
    {
      "clientId": "media-cli",
      "name": "Demo CLI client",
      "description": "Public client used by the demo script. Password grant for demo purposes; a real SPA would use Authorization Code + PKCE.",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost*"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "audience: media-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "media-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "media-web",
      "name": "Browser app",
      "description": "Public SPA client at https://app.localhost. Authorization Code + PKCE (S256 enforced), no password grant.",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://app.localhost/"],
      "webOrigins": ["https://app.localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://app.localhost/"
      },
      "protocolMappers": [
        {
          "name": "audience: media-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "media-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "media-mcp",
      "name": "MCP client (MCP Inspector, AI assistants)",
      "description": "Public client for MCP logins. Code + PKCE; password grant for the demo only. Tokens are for the MCP server (aud), never the api (ADR 0009). mcp:read/mcp:write are attached by keycloak-init.",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:6274/*", "http://127.0.0.1:6274/*"],
      "webOrigins": ["+"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "audience: MCP server URL",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "https://mcp.localhost/mcp", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "audience: MCP server client",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "media-mcp-server", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "media-mcp-server",
      "name": "MCP server",
      "description": "Confidential client of the MCP server. It exchanges the user's MCP token for a media-api token (RFC 8693, ADR 0009). Secret from MCP_CLIENT_SECRET.",
      "publicClient": false,
      "secret": "${MCP_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": { "standard.token.exchange.enabled": "true" },
      "protocolMappers": [
        {
          "name": "audience: media-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "media-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "media-mcp-billing",
      "name": "MCP server (billing lookups)",
      "description": "Service account the MCP server uses to ask billing whether a user is entitled (client credentials, ADR 0010). Its tokens are for media-billing only. Secret from MCP_BILLING_CLIENT_SECRET.",
      "publicClient": false,
      "secret": "${MCP_BILLING_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience: media-billing",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "media-billing", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "43ded860-c891-48e3-99af-bda9d985977d",
      "username": "demo",
      "enabled": true,
      "email": "demo@localhost",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "demo-pass", "temporary": false }
      ],
      "realmRoles": ["default-roles-media"]
    },
    {
      "id": "0a5250c5-fd5f-4c57-abd3-cdb5fe20ea99",
      "username": "alice",
      "enabled": true,
      "email": "alice@localhost",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "alice-pass", "temporary": false }
      ],
      "realmRoles": ["default-roles-media"]
    },
    {
      "id": "5d584c41-f952-4767-9318-042be1e7ce40",
      "username": "admin",
      "enabled": true,
      "email": "admin@localhost",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "admin-pass", "temporary": false }
      ],
      "realmRoles": ["default-roles-media", "admin"]
    }
  ]
}
